# ─────────────────────────────────────────────────────────────
# Supabase  (Projekt-Einstellungen → API)
# ─────────────────────────────────────────────────────────────
# Projekt-URL, z.B. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# "anon / public" Key. Darf im Client landen – die Absicherung
# passiert ueber die RLS-Policies aus supabase/migrations/.
SUPABASE_KEY=

# Nur fuer serverseitige Admin-Aufgaben (Migrationen, Seeds).
# NIEMALS als NUXT_PUBLIC_* exponieren.
# SUPABASE_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
# Legacy-API  (laeuft parallel weiter)
# ─────────────────────────────────────────────────────────────
# Wird ausschliesslich serverseitig vom Proxy unter
# server/api/legacy/[...path].ts aufgerufen.
LEGACY_API_BASE=http://116.203.22.63:5005

# Pfad, den der Browser anspricht. Auf '/api/legacy' lassen –
# ein direkter http-Aufruf wuerde auf Vercel (https) als
# Mixed Content blockiert.
NUXT_PUBLIC_API_BASE=/api/legacy

# ─────────────────────────────────────────────────────────────
# Nur fuer statisches Hosting in einem Unterverzeichnis (Apache).
# Auf Vercel leer lassen bzw. '/'.
# ─────────────────────────────────────────────────────────────
NUXT_APP_BASE_URL=/
